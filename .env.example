# Server-side AI configuration. Never commit real keys.
# Provide your own API key; the app does not read keys from the environment at build time.
USER_LLM_API_KEY=your-api-key-here
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_MODEL=gpt-4o-mini

# Comma-separated browser origins allowed to call the AI endpoint.
ALLOWED_ORIGINS=https://notioncrm.pages.dev,http://localhost:8000,http://localhost:8788
